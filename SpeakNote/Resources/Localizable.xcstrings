        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製原文"
          }
        }
      }
    },
    "Create a profile for language, provider, vocabulary, and note defaults." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立設定檔，集中管理語言、服務提供者、詞彙與筆記預設值。"
          }
        }
      }
    },
    "Creates a new job and keeps transcription on this Mac." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立新的工作項目，並在這部 Mac 上進行轉錄。"
          }
        }
      }
    },
    "Creates a new job and sends the source audio to Groq only after this click." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立新的工作項目；只有按下此按鈕後，才會將來源音訊傳送至 Groq。"
          }
        }
      }
    },
