    "Choose Apple Speech before enabling local-only transcription." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先選擇 Apple 語音辨識，再啟用僅限本機轉錄。"
          }
        }
      }
    },
    "Choose a format to create an append-only Markdown version." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇格式，以建立只會新增內容的 Markdown 版本。"
          }
        }
      }
    },
    "Choose one audio file (M4A, MP3, WAV, AIFF, or CAF)." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
