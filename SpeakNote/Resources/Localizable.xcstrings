{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Use “Copy Last Transcript” in SpeakNote." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請在 SpeakNote 中使用「複製最後一份逐字稿」。"
          }
        }
      }
    },
    "%@ · %@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "%@ → %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ → %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@"
          }
        }
      }
    },
    "%lld of %lld chunks" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld chunks"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld / %2$lld 個區段"
          }
        }
      }
    },
    "A recording is already in progress." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有一段錄音正在進行。"
          }
        }
      }
    },
    "A structured note can be generated after the raw transcript is complete." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始逐字稿完成後，即可產生結構化筆記。"
          }
        }
      }
    },
    "Accept" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受"
          }
        }
      }
    },
    "Accepted" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接受"
          }
        }
      }
    },
    "Accessibility" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助使用"
          }
        }
      }
    },
    "Accessibility lets SpeakNote post Command-V after restoring focus to the original app. If unavailable, SpeakNote keeps the transcript for explicit Copy." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「輔助使用」讓 SpeakNote 在焦點回到原本的 App 後送出 Command-V。若無法使用，SpeakNote 會保留逐字稿，供您自行複製。"
          }
        }
      }
    },
    "Accessibility permission for posting keyboard events is required to paste dictated text." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上聽寫文字需要「輔助使用」權限，才能送出鍵盤事件。"
          }
        }
      }
    },
    "Acknowledge the Groq cloud-processing disclosure before saving the API key." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存 API 金鑰前，請先確認 Groq 雲端處理告知事項。"
          }
        }
      }
    },
    "Active" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增"
          }
        }
      }
    },
    "Add Rule" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增規則"
          }
        }
      }
    },
    "Add a Groq API key in SpeakNote Settings before dictating." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始聽寫前，請先在 SpeakNote「設定」中加入 Groq API 金鑰。"
          }
        }
      }
    },
    "Add a Groq API key in SpeakNote Settings before processing text." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處理文字前，請先在 SpeakNote「設定」中加入 Groq API 金鑰。"
          }
        }
      }
    },
    "Apple Speech" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 語音辨識"
          }
        }
      }
    },
    "Apple Speech (On Device)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 語音辨識（裝置端）"
          }
        }
      }
    },
    "Apple Speech keeps primary transcription on this Mac. A cloud fallback is offered only when your fallback policy allows asking, and runs only after you accept." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 語音辨識會在這部 Mac 上進行主要轉錄。只有在備援政策允許詢問時，才會提供雲端備援選項，而且必須由您接受後才會執行。"
          }
        }
      }
    },
    "Apple Speech model is not downloaded" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下載 Apple 語音辨識模型"
          }
        }
      }
    },
    "Apple Speech model is unavailable" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 語音辨識模型無法使用"
          }
        }
      }
    },
    "Apple Speech provider not configured" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未設定 Apple 語音辨識服務"
          }
        }
      }
    },
    "Ask before switching local/cloud" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換本機／雲端前先詢問"
          }
        }
      }
    },
    "Audio" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊"
          }
        }
      }
    },
    "Audio conversion failed: %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊轉換失敗：%@"
          }
        }
      }
    },
    "Audio could not be written quickly enough. The recording was cancelled." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊寫入速度不足，錄音已取消。"
          }
        }
      }
    },
    "Audio could not seek to that source timestamp." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊無法跳至該來源時間點。"
          }
        }
      }
    },
    "Audio is sent to Groq for transcription. When cleanup, translation, or compression is selected, transcript text is also sent for processing." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊會傳送至 Groq 進行轉錄。選擇整理、翻譯或精簡時，逐字稿文字也會傳送出去處理。"
          }
        }
      }
    },
    "Audio playback could not be started." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開始播放音訊。"
          }
        }
      }
    },
    "Audio playback could not seek to that position." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊無法跳至該位置。"
          }
        }
      }
    },
    "Audio stays on this Mac." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊會留在這部 Mac 上。"
          }
        }
      }
    },
    "Audio will leave this Mac." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊將離開這部 Mac。"
          }
        }
      }
    },
    "Automatic insertion could not be confirmed safely." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法安全確認自動插入是否完成。"
          }
        }
      }
    },
    "Automatic paste is unavailable." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法自動貼上。"
          }
        }
      }
    },
    "Available" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用"
          }
        }
      }
    },
    "Available for the selected recognition language. On macOS 14–25, Apple Speech is limited to audio shorter than 55 seconds." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選辨識語言可用。在 macOS 14–25 上，Apple 語音辨識僅支援短於 55 秒的音訊。"
          }
        }
      }
    },
    "Back" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一步"
          }
        }
