    "Enabled terms are selected by priority for the transcription prompt. The prompt has a conservative 224-token budget." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用的詞彙會依優先順序加入轉錄提示詞，提示詞採保守的 224 token 上限。"
          }
        }
      }
    },
    "Enter a name for the voice note." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入語音筆記名稱。"
          }
        }
