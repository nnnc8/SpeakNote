      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote"
          }
        }
      }
    },
    "SpeakNote Couldn't Start" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote 無法啟動"
          }
        }
      }
    },
    "SpeakNote couldn't open its local data. Check available disk space and folder permissions, then try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote 無法開啟本機資料。請檢查可用磁碟空間與資料夾權限，然後再試一次。"
          }
        }
      }
    },
    "SpeakNote could not reach Groq. Check the network connection." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote 無法連線至 Groq，請檢查網路連線。"
          }
        }
      }
    },
    "SpeakNote could not register a global hotkey. Quit conflicting apps and retry." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote 無法註冊全域快速鍵。請結束可能衝突的 App 後再試一次。"
          }
        }
      }
    },
    "SpeakNote has no analytics or advertising tracking." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpeakNote 不含分析或廣告追蹤功能。"
          }
        }
      }
    },
    "SpeakNote records only when you start dictation or a voice note. Quick-dictation audio is deleted after the operation; Voice Note audio and transcripts stay in the app container until you delete the session." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在您開始聽寫或錄製語音筆記時，SpeakNote 才會錄音。快速聽寫的音訊會在操作完成後刪除；語音筆記的音訊與逐字稿則會留在 App 容器中，直到您刪除該工作階段。"
          }
        }
      }
    },
    "SpeakNote requests access only when you choose the related feature or press a request button." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在您使用相關功能或按下權限要求按鈕時，SpeakNote 才會要求取用權限。"
          }
        }
      }
    },
    "Speech Recognition" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音辨識"
          }
        }
      }
    },
    "Speech Recognition enables the optional on-device Apple Speech provider. Groq transcription does not require this permission." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「語音辨識」可啟用選用的裝置端 Apple 語音辨識服務。Groq 轉錄不需要此權限。"
          }
        }
      }
    },
    "Speech Recognition permission not granted" : {
      "localizations" : {
